{
	"compilerOptions": {
		"allowJs": true,
		"strict": true,
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"target": "ESNext",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"forceConsistentCasingInFileNames": true,
		"module": "ESNext",
		"isolatedModules": true,
		"types": ["node", "vite/client"],
		"noEmit": true
	},
	"include": ["./**/*"],
	"exclude": ["./_generated"]
}
