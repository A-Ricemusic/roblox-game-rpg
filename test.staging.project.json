{
	"name": "RobloxGameStagingTests",
	"globIgnorePaths": [
		"out/client/main.client.luau",
		"out/server/main.server.luau",
		"**/package.json",
		"**/tsconfig.json"
	],
	"tree": {
		"$className": "DataModel",
		"$properties": {
			"Attributes": {
				"RunQuestDataStoreStagingTests": { "Bool": true }
			}
		},
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@rbxts-js": {
						"$path": "node_modules/@rbxts-js"
					}
				}
			},
			"TS": {
				"$path": "out/shared"
			},
			"ClientTS": {
				"$path": "out/client"
			}
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"TS": {
				"$path": "out/server"
			}
		},
		"Workspace": {
			"$className": "Workspace"
		}
	}
}
