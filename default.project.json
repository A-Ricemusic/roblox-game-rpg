				"Brightness": 2.5,
				"ClockTime": 9.5,
				"EnvironmentDiffuseScale": 0.35,
				"EnvironmentSpecularScale": 0.5,
				"GlobalShadows": true,
				"OutdoorAmbient": [0.5, 0.52, 0.58],
				"Outlines": false,
				"ShadowSoftness": 0.25,
				"Technology": "ShadowMap"
			},
			"MediterraneanAtmosphere": {
				"$className": "Atmosphere",
				"$properties": {
					"Color": [0.78, 0.84, 0.92],
					"Decay": [0.42, 0.48, 0.58],
					"Density": 0.22,
					"Glare": 0.12,
					"Haze": 1.3,
					"Offset": 0.05
				}
			},
			"SunRays": {
				"$className": "SunRaysEffect",
				"$properties": {
					"Intensity": 0.08,
					"Spread": 0.65
				}
			}
		},
		"SoundService": {
			"$properties": {
				"RespectFilteringEnabled": true
			}
		}
	}
}
