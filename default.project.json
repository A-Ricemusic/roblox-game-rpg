{
	"name": "RobloxGame",
	"globIgnorePaths": [
		"out/**/*.spec.luau",
		"out/**/*.test.luau",
		"node_modules/@rbxts/jest*/**",
		"node_modules/@rbxts/emittery/**",
		"node_modules/@rbxts/pretty-format/**",
		"node_modules/@rbxts-js/**",
		"**/package.json",
		"**/tsconfig.json"
	],
	"tree": {
		"$className": "DataModel",

		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@rbxts-js": {
						"$path": "node_modules/@rbxts-js"
					}
				}
			},
			"TS": {
				"$path": "out/shared"
			}
		},

		"ServerScriptService": {
			"$className": "ServerScriptService",
			"TS": {
				"$path": "out/server"
			}
		},

		"StarterPlayer": {
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"TS": {
					"$path": "out/client"
				}
			}
		},

		"Workspace": {
			"$properties": {
				"FilteringEnabled": true
			},
			"Baseplate": {
				"$className": "Part",
				"$properties": {
					"Anchored": true,
					"Color": [0.38823, 0.37254, 0.38823],
					"Locked": true,
					"Position": [0, -10, 0],
					"Size": [512, 20, 512]
				}
			},
			"BetaInventoryPickups": {
				"$className": "Folder",
				"OliveBranch01": {
					"$className": "Part",
					"$properties": {
						"Anchored": true,
						"Attributes": {
							"InventoryPickupId": { "String": "beta-inventory:olive-branch:01" },
							"InventoryItemId": { "String": "sacred_olive_branch" },
							"InventoryItemQuantity": { "Float64": 1 }
						},
						"CanCollide": false,
						"Color": [0.32157, 0.56863, 0.16863],
						"Material": "SmoothPlastic",
						"Position": [-14, 1.25, -10],
						"Shape": "Ball",
						"Size": [2.8, 1.4, 1.8],
						"Tags": ["InventoryPickup"]
					},
					"GatherPrompt": {
						"$className": "ProximityPrompt",
						"$properties": {
							"ActionText": "Gather",
							"HoldDuration": 0.2,
